# Required
MONGODB_URI=mongodb+srv://user:pass@cluster0.mongodb.net/shiftswap
JWT_SECRET=change-me-long-random-string
# Required to register a manager account via the public form (managers can also promote users)
MANAGER_SETUP_CODE=choose-a-secret-code
# Optional
PORT=3000
NODE_ENV=production
# Optional - only for Google Calendar sync
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://your-app.onrender.com/api/calendar/callback
